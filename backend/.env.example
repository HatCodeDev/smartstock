# ─── Database ────────────────────────────────────────────────────────────────
# SQLite para desarrollo | postgresql+asyncpg://user:pass@host/db para producción
DATABASE_URL=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Genera uno seguro con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ─── MQTT (HiveMQ Cloud) ──────────────────────────────────────────────────────
# Cluster URL sin el prefijo "mqtts://" (solo el hostname)
MQTT_BROKER_URL=

# 8883 = TLS/SSL (HiveMQ Cloud) | 1883 = sin TLS (local/Mosquitto)
MQTT_PORT=8883

# Credenciales del cluster HiveMQ Cloud
MQTT_USERNAME=
MQTT_PASSWORD=

# ID único que identifica esta instancia del backend en el broker
MQTT_DEVICE_ID=